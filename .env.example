# Copy this file to .env and fill in your keys. Never commit .env.

# Groq (tried first). The _2 key is optional and used if the first fails.
GROQ_API_KEY=
GROQ_API_KEY_2=

# Gemini (fallback). The _2 key is optional.
GEMINI_API_KEY=
GEMINI_API_KEY_2=

# Optional: override models if a provider retires the defaults.
# GROQ_MODEL=openai/gpt-oss-120b
# GEMINI_MODEL=gemini-3.8-flash
